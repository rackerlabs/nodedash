# Copy to .env and fill in for your region. No real values belong in git.
HOST=127.0.0.1
PORT=8080

# Public origin this service is reached on. Keystone must list
# ${PUBLIC_URL}/api/auth/websso in its `trusted_dashboard` setting.
PUBLIC_URL=https://nodedash.example.invalid

KEYSTONE_URL=https://keystone.example.invalid

# Ironic is found in the Keystone service catalog for the region the user picks.
# Use "internal" when the BFF should reach Ironic over an internal network.
IRONIC_INTERFACE=public

# Encrypts the session cookie, which holds the user's Keystone tokens. Every
# replica needs the same keys. 32 bytes, base64. Generate with: openssl rand -base64 32
# To rotate, put the new key first and keep the old one until sessions expire.
SESSION_KEYS=replace-me-with-the-output-of-openssl-rand-base64-32
SESSION_TTL_HOURS=8

# Set to 0 only when serving plain HTTP locally and the browser (Safari) will not
# keep Secure cookies on http://localhost.
COOKIE_SECURE=1

# Default WebSSO protocol, and the IdPs offered on the sign-in page as
# id:protocol:label entries.
WEBSSO_PROTOCOL=openid
IDENTITY_PROVIDERS=example-idp:openid:Example SSO

# What this deployment calls the app: page title, header and sign-in page.
# BRAND_NAME=nodedash
# BRAND_TAGLINE=Hardware administration for OpenStack Ironic bare metal nodes.
# An http(s) URL or a same-origin path (for example one served from STATIC_DIR).
# BRAND_LOGO_URL=

# Bound on the cross-project fan-out used to resolve a shared node link.
LOCATE_CONCURRENCY=8
PROJECT_LIST_LIMIT=2000
NODE_PAGE_SIZE=500
MAX_NODE_PAGES=40

# Only needed where a node exposes both serial and graphical consoles.
# GRAPHICAL_CONSOLE_TYPE=

# Serve the built SPA from here (apps/web/dist) instead of running Vite.
# STATIC_DIR=../web/dist
LOG_LEVEL=info
